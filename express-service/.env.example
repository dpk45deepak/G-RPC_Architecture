# Port Express listens on for React
PORT=3000

# Base URL of the FastAPI REST API (still used directly in Experiment 1,
# React -> FastAPI, to compare against the gRPC path)
FASTAPI_URL=http://localhost:8000

# Phase 2: host:port of FastAPI's gRPC server (note: no http://, and a
# different port from FASTAPI_URL above — these are two separate servers)
FASTAPI_GRPC_URL=localhost:50051
